        "jsCode": "const msg = $json.message || {};\nconst txt = String(msg.text || '').trim();\nconst chatId = msg.chat && msg.chat.id;\nconst msgId = msg.message_id;\n\nconst loc = txt.match(/\\b(CEN|NOR|SUL)\\s*-\\s*(\\d+)\\b/i);\nconst st  = txt.match(/\\b(rebaixad[oa]|troca|perda)\\b/i);\nif (!loc || !st) return [];              // não é comando -> ignora\n\nconst cod = loc[1].toUpperCase();\nconst ean = loc[2];\nlet s = st[1].toLowerCase();\ns = s.startsWith('rebaix') ? 'Rebaixado' : (s === 'troca' ? 'Troca' : 'Perda');\n\nreturn [{ json: { cod, ean, status: s, chatId, msgId } }];"
      },
